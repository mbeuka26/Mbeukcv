# Base centrale. La clé service_role ne doit jamais être préfixée NEXT_PUBLIC_.
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 32+ caractères aléatoires. Chiffre les clés BYOK avant de les écrire.
# Gardez une copie hors de Git. Si cette valeur est perdue, les clés Claude
# déjà enregistrées dans les comptes deviennent illisibles. Elle ne va pas
# dans un fichier de récupération client.
ENCRYPTION_KEY=

# Vercel Cron envoie Authorization: Bearer <CRON_SECRET>
CRON_SECRET=

# JSearch via RapidAPI, clé de la plateforme uniquement. Les clients ne fournissent pas de clé.
# Deux requêtes par collecte, en rotation de métiers, plafond 180 sur 200 par mois.
# Ne pas forcer un pays : le filtre Cameroun empêchait les offres internationales.
RAPIDAPI_KEY=

# Optionnel. Africawork ne publie pas d’URL d’API. Ne remplissez ces lignes
# que si Africawork vous a donné une adresse réelle. Sinon, la page publique est scrapée.
AFRICAWORK_API_URL=
AFRICAWORK_API_KEY=

# Clé Anthropic du serveur. Sert uniquement à extraire la fiche CV. Jamais envoyée au navigateur.
ANTHROPIC_API_KEY=

# Clé SMTP Brevo et adresse d’expéditeur vérifiée dans Brevo.
BREVO_API_KEY=
BREVO_FROM_EMAIL=
BREVO_FROM_NAME=MbeukCV

# Job Exchange. URL complète de la fonction, secret serveur uniquement.
# Jamais de préfixe NEXT_PUBLIC_.
JOB_EXCHANGE_URL=
JOB_EXCHANGE_SERVICE_KEY=

# Adresse affichée au client quand son crédit est épuisé. Pas une clé secrète.
CONTACT_EMAIL=

# Licence Hub (kit 1.8). Identité et entitlement. Jamais en NEXT_PUBLIC_.
# MBEUK_HUB_URL est l'adresse du Hub. MBEUK_PRODUCT_ID et MBEUK_APPLICATION_ID
# viennent du Developer Portal, sans être écrits dans le code source.
MBEUK_HUB_URL=https://mbeukhub.vercel.app
MBEUK_PRODUCT_ID=
MBEUK_APPLICATION_ID=
MBEUK_AUTH_BRIDGE_SECRET=
MBEUK_ENVIRONMENT=development

# Paiement Chariow via le Hub. Jamais de clé Chariow dans ce projet.
# Chaque forfait a son produit dans le Hub. Sans ces identifiants, le client paie
# par Orange Money ou Mobile Money et envoie le reçu sur WhatsApp.
MBEUK_HUB_BASE_URL=https://mbeukhub.vercel.app
MBEUK_HUB_API_KEY=
MBEUK_HUB_PRODUCT_CLAUDE_10=
MBEUK_HUB_PRODUCT_CLAUDE_30=
MBEUK_HUB_PRODUCT_CLAUDE_80=
MBEUK_HUB_PRODUCT_RAPID_15=
MBEUK_HUB_PRODUCT_RAPID_40=
MBEUK_HUB_PRODUCT_RAPID_100=

# Secret que le Hub envoie pour ajouter le forfait après un paiement confirmé.
# Authorization: Bearer <CREDIT_GRANT_SECRET>
# POST /api/credits/grant  { "email", "packId", "saleId" }
CREDIT_GRANT_SECRET=
